module = I3C_STM32
module-str = i3c_stm32

source "subsys/logging/Kconfig.template.log_config"
config I3C_STM32
	bool "STM32 I3C driver support"
	depends on DT_HAS_ST_STM32_I3C_ENABLED
	select I3C_IBI_WORKQUEUE if I3C_USE_IBI && I3C_CONTROLLER
	select PINCTRL
	select RESET
	default y
	help
	  Enable support for I3C on STM32 microcontrollers.

if I3C_STM32

config I3C_STM32_COMBINED_INTERRUPT
	bool
	default y if SOC_SERIES_STM32MP2X

config I3C_STM32_DMA
	bool "STM32 I3C DMA driver support"
	depends on I3C_CONTROLLER
	select DMA
	select CACHE_MANAGEMENT if DCACHE
	help
	  Enables support for I3C DMA mode on STM32 microcontrollers.

config I3C_STM32_DMA_FIFO_HEAP_SIZE
	int "DMA transfer buffer heap"
	depends on I3C_STM32_DMA
	default 2048
	help
	  Size of the heap used for DMA control words, status words and byte-stream
	  buffers. Allow eight bytes per message, the total read and write lengths,
	  cache-line padding and allocator overhead. Transfers that exceed the
	  available storage fail with ENOMEM.

endif # I3C_STM32
